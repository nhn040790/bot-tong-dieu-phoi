# Token của bot Telegram (lấy từ BotFather — KHÔNG chia sẻ cho ai)
BOT_TOKEN=

# Chuỗi bí mật cho đường webhook (tự đặt, vd: abc123xyz)
WEBHOOK_SECRET=webhook

# ID Telegram của chủ bot (cách nhau dấu phẩy nếu nhiều người). Lấy bằng cách nhắn /start cho bot lần đầu
OWNER_IDS=

# ID nhóm điều hành nhận báo cáo cuối ngày (nhóm Hikari-BOT hiện tại: -5592777368)
GROUP_CHAT_ID=

# Google Sheet chứa lead: JSON của service account (dán nguyên 1 dòng) + ID của file Sheet
GOOGLE_SA_JSON=
LEADS_SHEET_ID=
LEADS_SHEET_NAME=Leads
